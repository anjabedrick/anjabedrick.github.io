---
import Base from '../layouts/Base.astro';

const star = [
  ['situation', 'Situation', "I'm Anja! I'm from the US, where I earned a double bachelor's in Art&Technology and Political Science and worked as a part-time motion designer. Now, I'm preparing to graduate in June 2027 with a master's degree in interaction design from Umeå Institute of Design."],
  ['problem', 'Problem', 'Working to balance my interests in design, emerging technology, public health, and impactful policy.'],
  ['action', 'Action', "Currently preparing to embark on my interaction design thesis project."],
  ['result', 'Result', "The result of all of this? I can't wait to find out!"],
];
---
<Base title="About" description="Motion graphics in San Francisco to interaction design in Umeå.">
  <article class="about-page">
    <header class="about-head">
      <div>
        <p class="pill pill-label">San Francisco → Amsterdam → Umeå → Stavanger...</p>
        <h1>Anja Bedrick</h1>
        <p class="project-summary">Motion graphics in San Francisco to interaction design in Umeå.</p>
      </div>
      <img class="about-illustration" src="/media/dCXDWx8Hof5yj1O25qpGWs92l7A.svg" alt="Illustrated portrait of Anja" />
    </header>

    <div class="timeline" data-scroll-x>
      <img src="/media/I5dK3UQ7x9yWguGRYNnJyUDuXqE.svg" alt="Timeline: BA Art&Tech and Political Science, University of Oregon (2018–2022); Motion graphics designer, AppLovin (2020–2022); Motion graphics designer, FLEXeCHARGE (2021–2022); Creative researcher, Rathenau Instituut + DSS (2022–2023); UX design intern, SEED Studio (2023); Master's in Interaction Design, Umeå Institute of Design (2024–now); Design and communication, UNDP Sustainable Energy Hub (2025)." draggable="false" />
    </div>

    <div class="star about-star">
      {star.map(([k, h, p]) => <div class="star-card" data-k={k}><h4>{h}</h4><p>{p}</p></div>)}
    </div>
  </article>
</Base>
