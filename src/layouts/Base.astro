---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Connect from '../components/Connect.astro';
import { SITE } from '../site';

interface Props { title?: string; description?: string; image?: string }
const { title, description = SITE.description, image } = Astro.props;
const fullTitle = title ? `${title} – ${SITE.name}` : SITE.name;
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/media/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Cactus+Classical+Serif&family=Jost:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Connect />

    <!-- custom cursor: a dot that becomes a labelled pill over projects -->
    <div class="cursor" aria-hidden="true">
      <span class="cursor-pill">
        <span class="cursor-text"></span>
        <svg viewBox="0 0 256 256" width="20" height="20"><path d="M200 64v104a8 8 0 0 1-16 0V83.3L69.7 197.7a8 8 0 0 1-11.4-11.4L172.7 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z" fill="currentColor"/></svg>
      </span>
    </div>
    <!-- soft blur along the bottom edge of the window -->
    <div class="edge-blur" aria-hidden="true"></div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
