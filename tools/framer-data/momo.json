[{"t":"p","top":177,"left":113,"w":163,"h":23,"text":"Umeå Institute of Design","li":false},{"t":"h2","top":270,"left":80,"w":596,"h":144,"text":"Modular Movement","li":false},{"t":"p","top":398,"left":80,"w":596,"h":67,"text":"MoMo is a modular physiotherapy tool that adapts to suit patients' needs, rather than the other way around.","li":false},{"t":"p","top":489,"left":80,"w":596,"h":23,"text":"<em>Team: Anja Bedrick, Eskil Sverreson, Leonie Schüttler, Selin Bakış</em>","li":false},{"t":"p","top":546,"left":92,"w":102,"h":23,"text":"Product Design","li":false},{"t":"p","top":546,"left":234,"w":92,"h":23,"text":"Sound Design","li":false},{"t":"p","top":546,"left":366,"w":120,"h":23,"text":"Interaction Design","li":false},{"t":"p","top":546,"left":526,"w":129,"h":23,"text":"Arduino Electronics","li":false},{"t":"p","top":604,"left":92,"w":143,"h":23,"text":"Design for Healthcare","li":false},{"t":"img","top":165,"left":760,"w":596,"h":503,"src":"https://framerusercontent.com/images/rpfb52k9yx4oRDpAK7GWBfkb3Kk.jpg","alt":"design pic"},{"t":"img","top":943,"left":80,"w":616,"h":969,"src":"https://framerusercontent.com/images/Bo8IQO1ynSeOkTAhoWSOOHuTP1Y.png","alt":"process pic"},{"t":"p","top":949,"left":773,"w":74,"h":23,"text":"Orientation","li":false},{"t":"h2","top":1042,"left":740,"w":616,"h":72,"text":"Challenge","li":false},{"t":"h4","top":1153,"left":760,"w":516,"h":22,"text":"Situation","li":false},{"t":"p","top":1216,"left":720,"w":556,"h":45,"text":"A collaboration between interactions design and product design master's programs with a focus on auditory feedback.","li":false},{"t":"h4","top":1345,"left":760,"w":516,"h":22,"text":"Problem","li":false},{"t":"p","top":1408,"left":720,"w":556,"h":68,"text":"The need for accessible, quality fine-motor skill training physiotherapy is increasing globally. However, 70% of patients struggle to keep up with their practice at home. How might we design a home-based practice that patients want to engage with?","li":false},{"t":"h4","top":1559,"left":760,"w":516,"h":22,"text":"Action","li":false},{"t":"p","top":1622,"left":720,"w":556,"h":68,"text":"Building on the experience of our two teammembers who are engaged in long-term physiotherapy, we prototyped quickly using 3D printed shells and Arduino electronics to iterate rapidly.","li":false},{"t":"h4","top":1774,"left":760,"w":516,"h":22,"text":"Result","li":false},{"t":"p","top":1837,"left":720,"w":556,"h":45,"text":"A modular, gamified fine-motor-skill training tool that challenges, motivates, and adapts to each patient's ability and goals.","li":false},{"t":"img","top":2022,"left":205,"w":1027,"h":206,"src":"https://framerusercontent.com/images/Fsu9vTAUivDiDD5KGdYii0TlMg8.gif","alt":""},{"t":"h3","top":2555,"left":80,"w":596,"h":43,"text":"01 Mind mapping","li":false},{"t":"p","top":2582,"left":80,"w":596,"h":58,"text":"Our discover phase involved mapping the current problem based on desk research and user stories.","li":false},{"t":"img","top":2338,"left":760,"w":596,"h":503,"src":"https://framerusercontent.com/images/IHb7wyqN9bx0cT2FRvBPJVQVsDc.jpg","alt":"design pic"},{"t":"img","top":3062,"left":80,"w":596,"h":689,"src":"https://framerusercontent.com/images/tS4VMDiwePpv0KiwRq3eS1LRS8.png","alt":""},{"t":"img","top":3761,"left":80,"w":596,"h":337,"src":"https://framerusercontent.com/images/6PuRsbg9gfUGfWYlhWhWYf40.png","alt":""},{"t":"h3","top":3516,"left":720,"w":596,"h":43,"text":"02 Physical prototyping","li":false},{"t":"p","top":3544,"left":720,"w":596,"h":115,"text":"Our concept was to take existing fine motor skill physiotherapy treatments, and make them adaptable, gamified, and portable. 3D printing multiple slightly varied options for the physical product to test practical usability.","li":false},{"t":"h3","top":4697,"left":80,"w":596,"h":43,"text":"03 Shell design","li":false},{"t":"p","top":4724,"left":80,"w":596,"h":58,"text":"Testing the feel of the physical shells, without the addition of light and sound feedback.","li":false},{"t":"img","top":4319,"left":819,"w":478,"h":289,"src":"https://framerusercontent.com/images/AKS2aOwid9JmY5ISNNGgvuuIpW8.png","alt":""},{"t":"img","top":4618,"left":819,"w":478,"h":527,"src":"https://framerusercontent.com/images/W9xr6o31vBQlBfcdzqxJn2RrIo.png","alt":""},{"t":"video","top":5366,"left":80,"w":435,"h":622,"src":"https://framerusercontent.com/assets/aVQMgObe4so5GgYUL767vkWiVE.mp4"},{"t":"h3","top":5642,"left":559,"w":757,"h":43,"text":"04 Electronics + Wizard of Oz","li":false},{"t":"p","top":5669,"left":559,"w":757,"h":58,"text":"Encoding light feedback to test our gamified feedback hypothesis: can simple, positive feedback change our users' behavior?","li":false},{"t":"h3","top":6295,"left":80,"w":596,"h":43,"text":"05 Sound design","li":false},{"t":"p","top":6323,"left":80,"w":596,"h":86,"text":"Our concept was to take existing physiotherapy treatments, and make them adaptable, gamified, and portable. 3D printing multiple slightly varied options for the physical product to test practical usability.","li":false},{"t":"img","top":6209,"left":817,"w":482,"h":271,"src":"https://framerusercontent.com/images/wSIFK1n1ea5oi1fbtLzCvYBmaI.png","alt":""},{"t":"video","top":6701,"left":80,"w":596,"h":280,"src":"https://framerusercontent.com/assets/gyBWEoisStW7bx2O45SAcdRE7Q.mp4"},{"t":"video","top":6991,"left":80,"w":596,"h":286,"src":"https://framerusercontent.com/assets/ZKWJ9fxOyxMZdCMNKV7vfO4nNF8.mp4"},{"t":"video","top":7287,"left":80,"w":596,"h":326,"src":"https://framerusercontent.com/assets/IvjIYLKS3urP6VPOf1wLeZr80.mp4"},{"t":"video","top":7623,"left":80,"w":596,"h":292,"src":"https://framerusercontent.com/assets/NgRPxw8oRdmrAVPTCOL9hYKRShk.mp4"},{"t":"video","top":7925,"left":80,"w":596,"h":345,"src":"https://framerusercontent.com/assets/apSwl8UYpCTKtRwAcowLAtJjf9E.mp4"},{"t":"video","top":8280,"left":80,"w":596,"h":326,"src":"https://framerusercontent.com/assets/h2ZfrjGKrWvzHvML87mIyu3jcdc.mp4"},{"t":"video","top":8616,"left":80,"w":596,"h":325,"src":"https://framerusercontent.com/assets/qugvXyjUyrYq6qe0avi67Ku0gig.mp4"},{"t":"h3","top":6741,"left":720,"w":596,"h":43,"text":"04 Modules","li":false},{"t":"p","top":6768,"left":720,"w":596,"h":86,"text":"The brain, wrist rotation, finger strength, and dexterity are a few modules based on real fine motor skill tuning exercises that we brought to MoMo.","li":false},{"t":"h2","top":9191,"left":80,"w":1236,"h":72,"text":"Output","li":false},{"t":"p","top":9247,"left":80,"w":1236,"h":58,"text":"MoMo is a modular physiotherapy tool that adjusts to suit patients' needs, rather than the other way around. Built on real tools and research, this prototype employs gamified light and sound feedback to address low treatment-adherence.","li":false},{"t":"video","top":9354,"left":80,"w":1236,"h":150,"src":"https://framerusercontent.com/assets/xAJ5UVRZcZfvTTZZoKsAgu0cUQ.mp4"},{"t":"video","top":9528,"left":80,"w":1236,"h":540,"src":"https://framerusercontent.com/assets/DzYxT6NmXFZXVBUUVNSLpcJOQ.mp4"},{"t":"video","top":10092,"left":80,"w":1236,"h":540,"src":"https://framerusercontent.com/assets/NzW0Lf13YoabemtgwTlQS1gazQQ.mp4"},{"t":"video","top":10656,"left":80,"w":1236,"h":536,"src":"https://framerusercontent.com/assets/OqTTn2Tti9C7bef0MA6FhUAIxY.mp4"},{"t":"video","top":11236,"left":80,"w":1276,"h":625,"src":"https://framerusercontent.com/assets/KAsAAJrWhUb5XaBxUgMJhiCKP3k.mp4"},{"t":"img","top":11905,"left":80,"w":1276,"h":5086,"src":"https://framerusercontent.com/images/oG8NlHJeREGIEilKq9eMDDLy8.jpg","alt":""},{"t":"img","top":17101,"left":525,"w":386,"h":216,"src":"https://framerusercontent.com/images/uyTxtAj04Uphc1NtwR58OHs43Kk.gif","alt":""}]