---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import dims from '../data/media-dims.json';
const DIMS = dims as Record<string, [number, number]>;
const size = (src?: string) => { const d = src ? DIMS[src.split('/').pop()!] : undefined; return d ? { width: d[0], height: d[1] } : {}; };

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <article class="project">
    <header class="project-head">
      <div class="project-intro">
        {d.eyebrow && <p class="pill pill-school">{d.eyebrow}</p>}
        <h1>{d.title}</h1>
        <p class="project-summary">{d.summary}</p>
        {d.team && <p class="project-team">{d.team}</p>}
        {d.role && <p class="project-role">{d.role}</p>}
        {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      </div>
      {d.hero && (
        <div class="project-hero">
          {d.heroType === 'video'
            ? <video src={d.hero} {...size(d.hero)} muted loop playsinline autoplay preload="auto" data-autoplay></video>
            : <img src={d.hero} {...size(d.hero)} alt="" decoding="async" fetchpriority="high" />}
        </div>
      )}
    </header>

    <div class="project-body">
      <Content />
    </div>

    <a class="next-project" href={`/${next.id}`} data-cursor={next.data.cursorLabel}>
      <span class="pill">Next project</span>
      <span class="next-title">{next.data.title}</span>
      <img src={next.data.cover} {...size(next.data.cover)} alt="" loading="lazy" decoding="async" />
    </a>
  </article>
</Base>
