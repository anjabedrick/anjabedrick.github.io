---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import dims from '../data/media-dims.json';

// image size (so the page doesn't jump while loading) and GIF -> lighter MP4 when one exists
const DIMS = dims as Record<string, [number, number]>;
const media = (src: string) => {
  const name = src.split('/').pop()!;
  const mp4 = name.replace(/\.gif$/, '.mp4');
  const useVideo = name.endsWith('.mp4') || (name.endsWith('.gif') && DIMS[mp4] !== undefined);
  const file = useVideo ? mp4 : name;
  const [width, height] = DIMS[file] ?? [undefined, undefined];
  return { src: `/media/${file}`, video: useVideo, width, height };
};

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects
  .filter((p) => p.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
// the 3D stack shows the featured projects twice, ten cards in a loop
const stackCards = [...featured, ...featured];

const skills = [
  ['After Effects animation', '/illustration-and-animation-gallery#animation'],
  ['UI design', '/philips-telehealth-interface'],
  ['UX design', '/philips-telehealth-interface'],
  ['Branding', '/flexecharge-branding'],
  ['Figma', '/philips-telehealth-interface'],
  ['User research', '/philips-telehealth-interface'],
  ['Speculative design', '/speculative-product-design'],
  ['Motion design', '/illustration-and-animation-gallery#animation'],
];

const experience = [
  ['UX Design', 'Laerdal Medical', 'Sept 2025 – Aug 2026'],
  ['Design and Communication Internship', 'UNDP Sustainable Energy Hub', 'Summer 2025'],
  ["Interaction Design Master's", 'Umeå Institute of Design', 'Sept 2024 – June 2027'],
  ['Creative Research', 'Rathenau Instituut x DSS', 'Sept 2022 – Jan 2023'],
  ['Motion Design', 'AppLovin', 'June 2020 – Aug 2022'],
];

// Grid order comes from each project's `order` (first row: MoMo, Philips, gallery; second: AppLovin,
// comic, Rathenau). The About tile always sits in the bottom row's middle column.
type Card = { href: string; img: string; label: string; cats: string[]; id?: string; about?: boolean };
const cards: Card[] = projects.map((p) => ({ href: `/${p.id}`, img: p.data.cover, label: p.data.cursorLabel, cats: p.data.categories, id: p.id }));
const total = cards.length + 1;
const lastRowStart = Math.floor((total - 1) / 3) * 3;
const aboutAt = Math.min(lastRowStart + 1, total - 1);
cards.splice(aboutAt, 0, { href: '/about-anja', img: '/media/mCNElRGQgNVvMvyA5qbj0E3Ws.mp4', label: 'About Me', cats: [], about: true });
// three columns, filled left to right like the Framer grid
const columns: Card[][] = [[], [], []];
cards.forEach((c, i) => columns[i % 3].push(c));

// filter chips, in this order; a chip only shows if at least one project uses it
const FILTERS = ['UX design', 'Digital product design', 'Visual design', 'Experience design', 'Creative technology',
  'Illustration', 'Motion design', 'Branding', 'Speculative design', 'Process', 'User research'];
const filters = FILTERS.filter((f) => cards.some((c) => c.cats.includes(f)));

// the two dice chips: each click shows one different project from its set
const PICKS = {
  funky: ['speculative-product-design', 'illustration-and-animation-gallery', 'quantum-physics-comic'],
  polished: ['philips-telehealth-interface', 'momo', 'flexecharge-branding', 'tripcom-design-process'],
};
const dice = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8.5" cy="8.5" r="1.4" fill="currentColor"/><circle cx="15.5" cy="8.5" r="1.4" fill="currentColor"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/><circle cx="8.5" cy="15.5" r="1.4" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.4" fill="currentColor"/></svg>';
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name" data-split aria-label="Anja Bedrick"><a class="hero-name-link" href="#about-me"><span class="line">Anja</span> <span class="line">Bedrick</span></a></h1>
      <p class="hero-role">Interaction designer</p>
      <a class="hero-hint" href="#all-projects">
        <span>Select a featured project below or</span>
        <span class="hero-hint-line"></span>
        <svg class="hero-mouse" viewBox="0 0 28 42" width="28" height="42" aria-hidden="true">
          <rect x="7" y="9" width="14" height="24" rx="7" fill="none" stroke="currentColor" stroke-width="1.5" />
          <line class="wheel" x1="14" y1="14" x2="14" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="hero-hint-line"></span>
        <span>scroll all the way down to see everything.</span>
      </a>
    </div>

    <div class="stack-clip">
    <div class="stack" aria-label="Featured projects">
      <div class="stack-group">
        {stackCards.map((p, i) => (
          <a class="stack-card" href={`/${p.id}`} data-cursor={p.data.cursorLabel} tabindex={i < featured.length ? 0 : -1}>
            {(() => { const m = media(p.data.cover); return m.video
              ? <video src={m.src} width={m.width} height={m.height} muted loop playsinline autoplay aria-label={p.data.title}></video>
              : <img src={m.src} width={m.width} height={m.height} alt={p.data.title} loading="eager" decoding="async" draggable="false" />; })()}
            <span class="stack-caption" aria-hidden="true">{p.data.cursorLabel}</span>
          </a>
        ))}
      </div>
    </div>
    <button class="stack-arrow stack-prev" type="button" data-stack-dir="-1" aria-label="Previous project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="stack-arrow stack-next" type="button" data-stack-dir="1" aria-label="Next project">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    </div>
  </section>

  <section class="about-me" id="about-me" data-cursor-theme="light">
    <div class="about-me-inner">
      <div class="about-me-text">
        <h2>Hej, I'm Anja.</h2>
        <p class="lead">I'm an interaction designer with a background in motion graphics and UX design.</p>
        <ul class="skills">
          {skills.map(([s, href]) => <li><a href={href}>{s}</a></li>)}
        </ul>
        <table class="experience">
          <tbody>
            {experience.map(([role, org, when]) => (
              <tr><td>{role}</td><td>{org}</td><td>{when}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/about-anja" class="about-me-photo" data-cursor="About Me">
        <img src="/media/DumLpsX1VQ7LIqi85QTJYYGo4.jpeg" {...(() => { const m = media('/media/DumLpsX1VQ7LIqi85QTJYYGo4.jpeg'); return { width: m.width, height: m.height }; })()} alt="Anja Bedrick" loading="lazy" decoding="async" />
      </a>
    </div>
  </section>

  <section class="all-projects" id="all-projects">
    <h2 class="section-title">All projects</h2>
    <div class="filters" role="group" aria-label="Filter projects">
      <button type="button" class="chip" aria-pressed="true" data-filter="">All</button>
      <button type="button" class="chip chip-dice" aria-pressed="false" data-pick={PICKS.funky.join('|')}><Fragment set:html={dice} />Something funky</button>
      <button type="button" class="chip chip-dice" aria-pressed="false" data-pick={PICKS.polished.join('|')}><Fragment set:html={dice} />Something polished</button>
      {filters.map((f) => <button type="button" class="chip" aria-pressed="false" data-filter={f}>{f}</button>)}
    </div>
    <div class="grid" aria-live="polite">
      {columns.map((col) => (
        <div class="grid-col">
          {col.map((c) => (
            <a class:list={["card", { "card-about": c.about }]} href={c.href} data-cursor={c.label} data-cats={c.cats.join('|')} data-id={c.id}>
              {(() => { const m = media(c.img); return m.video
                ? <video src={m.src} width={m.width} height={m.height} muted loop playsinline preload="metadata" data-autoplay></video>
                : <img src={m.src} width={m.width} height={m.height} alt="" loading="lazy" decoding="async" />; })()}
              <span class="card-caption">{c.label}</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>
