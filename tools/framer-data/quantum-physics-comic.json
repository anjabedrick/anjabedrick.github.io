[{"t":"p","top":176,"left":231,"w":357,"h":23,"text":"Science and Comics Fellowship | University of Oregon","li":false},{"t":"h2","top":269,"left":198,"w":478,"h":144,"text":"Quantum Physics Comic","li":false},{"t":"p","top":397,"left":198,"w":478,"h":67,"text":"How to engage undergraduate physics students using a non-traditional medium?","li":false},{"t":"p","top":498,"left":210,"w":164,"h":23,"text":"Inter-Disciplinary Design","li":false},{"t":"p","top":498,"left":414,"w":109,"h":23,"text":"Adobe Illustrator","li":false},{"t":"p","top":498,"left":563,"w":74,"h":23,"text":"Storytelling","li":false},{"t":"p","top":556,"left":210,"w":94,"h":23,"text":"Storyboarding","li":false},{"t":"p","top":556,"left":344,"w":68,"h":23,"text":"Illustration","li":false},{"t":"p","top":556,"left":451,"w":82,"h":23,"text":"Infographics","li":false},{"t":"p","top":556,"left":573,"w":51,"h":23,"text":"Comics","li":false},{"t":"img","top":183,"left":760,"w":478,"h":417,"src":"https://framerusercontent.com/images/UlqSk0H4QzPexcJg3MbdLHdtkWw.jpg","alt":"design pic"},{"t":"h3","top":688,"left":228,"w":980,"h":43,"text":"At a Glance","li":false},{"t":"img","top":763,"left":231,"w":974,"h":741,"src":"https://framerusercontent.com/images/zwglCxki3Lv74r3qPq4KxyiotU.png","alt":""},{"t":"p","top":1536,"left":228,"w":980,"h":67,"text":"An original, illustrated comic designed to engage undergraduate students with a unique educational tool via visual learning and storytelling.","li":false},{"t":"p","top":1705,"left":398,"w":153,"h":23,"text":"Too Long, Didn't Read?","li":false,"href":"./quantum-physics-comic#output"},{"t":"p","top":1705,"left":782,"w":256,"h":23,"text":"keep scrolling to read the whole comic","li":false,"href":"./quantum-physics-comic#output"},{"t":"h4","top":1789,"left":218,"w":408,"h":22,"text":"Situation","li":false},{"t":"p","top":1852,"left":178,"w":448,"h":68,"text":"A fellowship between the science and comics departments at University of Oregon. Two design students per year pair up with a research team.","li":false},{"t":"h4","top":2004,"left":218,"w":408,"h":22,"text":"Action","li":false},{"t":"p","top":2067,"left":178,"w":448,"h":45,"text":"Meeting in the lab every week to understand the research, and co-create our comic.","li":false},{"t":"h4","top":1789,"left":750,"w":408,"h":22,"text":"Problem","li":false},{"t":"p","top":1852,"left":710,"w":448,"h":68,"text":"How might a design undergraduate student co-create a comic about an ion trap experiment that is engaging, accessible, and educational?","li":false},{"t":"h4","top":2004,"left":750,"w":408,"h":22,"text":"Result","li":false},{"t":"p","top":2067,"left":710,"w":448,"h":68,"text":"A 10 page comic designed to explain the researchers' work with ion-trapping to undergraduate students in an engaging, accessible way.","li":false},{"t":"p","top":2270,"left":231,"w":102,"h":23,"text":"Design process","li":false},{"t":"h2","top":2363,"left":198,"w":1040,"h":72,"text":"Process","li":false},{"t":"p","top":2419,"left":198,"w":640,"h":67,"text":"\"If I can understand what you guys are doing here, anybody can.\" - Anja","li":false},{"t":"h3","top":2905,"left":198,"w":478,"h":43,"text":"01 Meeting the Researchers","li":false},{"t":"p","top":2933,"left":198,"w":478,"h":101,"text":"Meet the team. I joined David weekly in the lab to learn about the researchers' work, take notes, and sketch equipment.","li":false},{"t":"img","top":2611,"left":760,"w":478,"h":702,"src":"https://framerusercontent.com/images/AI7ZmOwA40UPqNRm9ynYlabW7A.png","alt":"design pic"},{"t":"img","top":3357,"left":198,"w":478,"h":422,"src":"https://framerusercontent.com/images/uK7EBqtmUEmH0AmgCPVMwvG8cM.jpg","alt":"design pic"},{"t":"h3","top":3478,"left":720,"w":478,"h":43,"text":"02 Co-Creation","li":false},{"t":"p","top":3505,"left":720,"w":478,"h":168,"text":"Because the comic would be used as educational material, scientific accuracy was of top importance. We sketched ideas together, and everything I came up with would be reviewed by the team.","li":false},{"t":"h3","top":4018,"left":198,"w":478,"h":43,"text":"03 Illustration Iteration","li":false},{"t":"p","top":4045,"left":198,"w":478,"h":101,"text":"Opening up Adobe Illustrator on my laptop in the lab, we could quickly iterate if an idea was working or not.","li":false},{"t":"img","top":3823,"left":760,"w":478,"h":503,"src":"https://framerusercontent.com/images/CUbcyWY0hmVGLw7ghEx37HuhA.webp","alt":"design pic"},{"t":"h2","top":4600,"left":198,"w":1000,"h":72,"text":"Output","li":false},{"t":"p","top":4656,"left":198,"w":1000,"h":34,"text":"Check out the final comic below!","li":false},{"t":"img","top":4739,"left":198,"w":1000,"h":6965,"src":"https://framerusercontent.com/images/qrQJL5lOoIguX5AaUpJNYf557U.jpg","alt":"design pic"}]